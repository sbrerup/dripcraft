{
  "patches": [
    {
      "file": "/data/spigot.yml",
      "ops": [
        {
          "$set": {
            "path": "$['world-settings']['default']['mob-spawn-range']",
            "value": 6,
            "value-type": "int"
          }
        }
      ]
    },
    {
      "file": "/data/config/paper-world-defaults.yml",
      "ops": [
        {
          "$set": {
            "path": "$['misc']['redstone-implementation']",
            "value": "ALTERNATE_CURRENT"
          }
        },
        {
          "$set": {
            "path": "$['anticheat']['anti-xray']['enabled']",
            "value": true,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['anticheat']['anti-xray']['hidden-blocks']",
            "value": [
              "copper_ore",
              "deepslate_copper_ore",
              "raw_copper_block",
              "gold_ore",
              "deepslate_gold_ore",
              "iron_ore",
              "deepslate_iron_ore",
              "raw_iron_block",
              "coal_ore",
              "deepslate_coal_ore",
              "lapis_ore",
              "deepslate_lapis_ore",
              "mossy_cobblestone",
              "obsidian",
              "chest",
              "diamond_ore",
              "deepslate_diamond_ore",
              "redstone_ore",
              "deepslate_redstone_ore",
              "clay",
              "emerald_ore",
              "deepslate_emerald_ore",
              "ender_chest",
              "ancient_debris",
              "nether_gold_ore",
              "nether_quartz_ore"
            ]
          }
        }
      ]
    },
    {
      "file": "/data/bukkit.yml",
      "ops": [
        {
          "$set": {
            "path": "$['settings']['permissions-file']",
            "value": "config/player-permissions.yml"
          }
        }
      ]
    },
    {
      "file": "/data/plugins/Timberella/config.yml",
      "ops": [
        {
          "$set": {
            "path": "$['enable_replant']",
            "value": false,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['tools']['durability_multiplier']",
            "value": 1,
            "value-type": "float"
          }
        }
      ]
    },
    {
      "file": "/data/plugins/DiscordSRV/config.yml",
      "ops": [
        {
          "$set": {
            "path": "$['DiscordChatChannelConsoleCommandEnabled']",
            "value": false,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['ServerWatchdogEnabled']",
            "value": false,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['ChannelTopicUpdaterChannelTopicsAtShutdownEnabled']",
            "value": false,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['DiscordCannedResponses']",
            "value": {}
          }
        }
      ]
    },
    {
      "file": "/data/plugins/DiscordSRV/messages.yml",
      "ops": [
        {
          "$set": {
            "path": "$['ChannelTopicUpdaterChatChannelTopicFormat']",
            "value": ""
          }
        },
        {
          "$set": {
            "path": "$['ChannelTopicUpdaterConsoleChannelTopicFormat']",
            "value": ""
          }
        }
      ]
    },
    {
      "file": "/data/plugins/Chunky/config.yml",
      "ops": [
        {
          "$set": {
            "path": "$['continue-on-restart']",
            "value": true,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['update-interval']",
            "value": 60,
            "value-type": "int"
          }
        }
      ]
    }
  ]
}
