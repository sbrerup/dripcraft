# Serves the player statistics page and the web map over HTTPS. playit passes TLS
# through without ending it, so Caddy gets the certificate from Let's Encrypt
# itself (see README).
{
	# Not root, so not 80 and 443. The tunnel's origin maps those to these.
	http_port 8080
	https_port 8443
	admin off
	skip_install_trust
}

# The map's address lives in the web-map Secret, not in this public repository.
# Until the Secret exists, Caddy serves localhost only and asks for no certificate.
{$MAP_DOMAIN:localhost} {
	# Asks search engines to list nothing here: the hub, the numbers and the map.
	# Not a robots.txt, because a crawler that is kept out never sees this.
	header X-Robots-Tag "noindex, nofollow"

	# The web map, at /map/. squaremap asks for everything by relative address,
	# so it works under a folder with the folder's name taken off.
	redir /map /map/
	handle_path /map/* {
		reverse_proxy minecraft:8080
	}

	# Everything else is the members' hub (see README). Its files are in
	# Git, and the player-stats container beside Caddy writes the numbers, skins
	# and flags every few minutes.
	handle_path /data/* {
		root * /srv/stats-data
		encode zstd gzip
		header Cache-Control no-cache
		file_server
	}
	handle {
		root * /srv/stats-page
		encode zstd gzip
		# The browser asks whether a file has changed before using its copy, so a
		# change to the hub shows at once.
		header Cache-Control no-cache
		# Every address that is not a file is a page the hub draws itself.
		try_files {path} /index.html
		file_server
	}
}
