{
  "patches": [
    {
      "file": "/data/config/paper-world-defaults.yml",
      "ops": [
        {
          "$set": {
            "path": "$['misc']['redstone-implementation']",
            "value": "ALTERNATE_CURRENT"
          }
        }
      ]
    },
    {
      "file": "/data/plugins/DiscordSRV/config.yml",
      "ops": [
        {
          "$set": {
            "path": "$['DiscordChatChannelConsoleCommandEnabled']",
            "value": false,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['ServerWatchdogEnabled']",
            "value": false,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['ChannelTopicUpdaterChannelTopicsAtShutdownEnabled']",
            "value": false,
            "value-type": "bool"
          }
        },
        {
          "$set": {
            "path": "$['DiscordCannedResponses']",
            "value": {}
          }
        },
        {
          "$set": {
            "path": "$['MaximumAttemptsForSystemDNSBeforeUsingFallbackDNS']",
            "value": -1,
            "value-type": "int"
          }
        }
      ]
    },
    {
      "file": "/data/plugins/DiscordSRV/messages.yml",
      "ops": [
        {
          "$set": {
            "path": "$['ChannelTopicUpdaterChatChannelTopicFormat']",
            "value": ""
          }
        },
        {
          "$set": {
            "path": "$['ChannelTopicUpdaterConsoleChannelTopicFormat']",
            "value": ""
          }
        }
      ]
    }
  ]
}
